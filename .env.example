# On Doubt, Use Us :) - Variáveis de Ambiente

# Porta e Host do servidor de downloads (local-server.mjs)
PORT=8787
HOST=127.0.0.1

# Diretório onde os downloads serão salvos (opcional - padrão é ~/Downloads/On Doubt Use Us)
# DOWNLOAD_DIR=C:\Downloads\On Doubt Use Us

# Origens permitidas para CORS (separadas por vírgula ou '*' para todas)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# URL da API consumida pelo Frontend Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
