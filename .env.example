# On Doubt, Use Us :) - Variáveis de Ambiente

# Porta e Host do servidor de downloads (local-server.mjs)
PORT=8787
HOST=127.0.0.1

# Diretório onde os downloads serão salvos (opcional - padrão é ~/Downloads/On Doubt Use Us)
# DOWNLOAD_DIR=C:\Downloads\On Doubt Use Us

# Origens permitidas para CORS (separadas por vírgula ou '*' para todas)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# URL da API consumida pelo Frontend Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Cookies são opcionais: deixe todas as opções abaixo comentadas para uso anônimo.
# Não use sua conta pessoal como sessão compartilhada de um site público.
# Autenticação opcional do YouTube — escolha apenas UMA opção se necessário:
# Local: nome do navegador que já está conectado ao YouTube.
# Compatíveis: chrome, edge, firefox, brave, chromium, opera, vivaldi, safari.
# YOUTUBE_COOKIES_BROWSER=chrome
# YOUTUBE_COOKIES_BROWSER_PROFILE=Default

# Servidor/Render: conteúdo do cookies.txt codificado em base64.
# Cadastre como variável secreta no painel; nunca salve o valor neste arquivo ou no Git.
# YOUTUBE_COOKIES_BASE64=

# Alternativa local: caminho absoluto para um cookies.txt no formato Netscape.
# YOUTUBE_COOKIES_FILE=C:\caminho\privado\cookies.txt

# Normalmente deve ficar vazio. Use somente para diagnóstico avançado.
# YOUTUBE_PLAYER_CLIENTS=web,web_safari
